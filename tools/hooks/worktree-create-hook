#!/usr/bin/env python3
r"""WorktreeCreate / WorktreeRemove hook -- opt-in-per-repo worktree allocation.

When the Claude Code main session's cwd is not a git repo, the harness can't
allocate an agent worktree on its own ("Cannot create agent worktree: not in
a git repository and no WorktreeCreate hooks are configured"). This hook
fills that gap, but only for an explicit opt-in list read from config files.

Modes
-----
This script doubles as both the ``WorktreeCreate`` and ``WorktreeRemove``
hook. The harness invokes the same binary; behaviour is selected by
``hook_event_name`` on stdin (or, as a fallback, the ``WORKTREE_HOOK_MODE``
env var / ``--remove`` flag for embedded tests).

Opt-in config
-------------
Opted-in repos are read from these config files (in order, all merged):

    /etc/claude-code/worktree-isolation-repos.txt        (system-wide)
    ~/.config/claude-watch/worktree-isolation-repos.txt  (user)

Each non-blank, non-comment (``#``) line is a pipe-separated record:

    repo_key|prompt_regex|upstream_path

  - ``repo_key`` -- short label, used in /tmp/<repo_key>-worktrees/ and audit log
  - ``prompt_regex`` -- case-insensitive regex matched against the Agent prompt
  - ``upstream_path`` -- absolute path to the upstream working tree (the
    ``git worktree add`` target).

Setting ``WORKTREE_ISOLATION_REPOS`` (os.pathsep-separated paths) REPLACES
both defaults -- for tests and local debugging.

KEEP IN SYNC with pre-agent-worktree-isolation-hook (same file format,
same loader semantics, same ``Worktree repo:`` override marker).

Sample config (place at /etc/claude-code/worktree-isolation-repos.txt)::

    # repo_key | prompt_regex | upstream_path
    claude-watch|(?:~/repos/claude-watch\b|/home/[^/\s]+/repos/claude-watch\b|\brepos/claude-watch\b|\b(?:hndrewaall|gbre-org)/claude-watch\b|\bgithub\.com/(?:hndrewaall|gbre-org)/claude-watch\b)|/home/USER/repos/claude-watch

Explicit repo-selection marker
------------------------------
A prompt can name its repo directly instead of relying on the regex::

    Worktree repo: claude-watch

The marker is a whole line (leading/trailing whitespace ignored, label
case-insensitive) whose value must be an EXACT ``repo_key`` from the opt-in
list -- never a free-form path. It takes precedence over the regexes, and a
marker naming a key that is not opted in is REFUSED rather than ignored.
``pre-agent-worktree-isolation-hook`` honours the same marker, so a prompt
carrying it is treated as "touches that repo" by the isolation gate too.

This exists because the regexes match *incidental prose* (the repo's path or
slug). A spawner that rewrites a prompt can silently drop the only phrase
that matched; the marker is the stable, intentional way to say which repo a
worktree belongs to.

Contract (Claude Code harness, verified 2026-05-19)
---------------------------------------------------
- stdin: JSON containing at minimum ``hook_event_name`` and (for the create
  path) some session context. Real-world payloads include keys like
  ``name``, ``cwd``, ``session_id`` and the Agent ``tool_input`` (we read
  ``prompt`` if present); for ``WorktreeRemove`` a ``worktree_path`` field
  identifies the directory to clean up.
- stdout for ``WorktreeCreate``: a single line containing the absolute path
  of the newly-created worktree, OR empty stdout to pass through to the
  harness's default behaviour (i.e. "not opted in, you handle it").
- stdout for ``WorktreeRemove``: ignored by the harness; we just clean up
  and exit 0.

Exit codes / failure posture
----------------------------
``WorktreeRemove`` always exits 0. ``WorktreeCreate`` exits 0 on success and
on a *viable* pass-through, and exits 2 -- with an actionable stderr
diagnostic -- when it cannot allocate and pass-through cannot work either.

Pass-through is viable only when the harness can allocate the worktree
itself, i.e. the session ``cwd`` is inside a git working tree. When it is
not (the case this hook exists for), empty stdout makes the harness report
the opaque "hook succeeded but returned no worktree path", which names
neither the cause nor the fix. Exiting non-zero surfaces our stderr instead:
the opted-in repo keys and the two ways to make the prompt select one.

The hook is still a silent no-op when no config file is present / parses,
so it is safe to install on a host with no opted-in repos.

Audit log: best-effort newline-delimited JSON to
``~/.config/claude/worktree-create.log`` (0600).

Embedded tests: ``worktree-create-hook --test``.
"""

from __future__ import annotations

import datetime as _dt
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from pathlib import Path

# Config file locations -- shared with pre-agent-worktree-isolation-hook.
CONFIG_FILES = [
    Path("/etc/claude-code/worktree-isolation-repos.txt"),
    Path(os.path.expanduser("~/.config/claude-watch/worktree-isolation-repos.txt")),
]

# Test/debug override: os.pathsep-separated config paths REPLACING the
# defaults above. Keeps the subprocess tests hermetic on hosts (CI) that have
# no config installed. KEEP IN SYNC with pre-agent-worktree-isolation-hook.
CONFIG_ENV_VAR = "WORKTREE_ISOLATION_REPOS"

LOG_DIR = Path(os.path.expanduser("~/.config/claude"))
LOG_PATH = LOG_DIR / "worktree-create.log"

# Tool names whose prompts we inspect for opt-in matches.
AGENT_TOOL_NAMES = {"Agent", "Task"}

# Worktree path layout: /tmp/<repo_key>-worktrees/agent-<UUID>
WORKTREE_BASE_TMPL = "/tmp/{repo_key}-worktrees"

# Prompt cache populated by pre-agent-worktree-isolation-hook on PreToolUse.
CACHE_DIR = Path(os.path.expanduser("~/.cache/claude"))
CACHE_TTL_SECONDS = 30
CACHE_FILENAME_TMPL = "last-agent-prompt-{session_id}.txt"

# Explicit repo-selection marker -- a whole line naming an opted-in repo_key.
# KEEP IN SYNC with pre-agent-worktree-isolation-hook.
REPO_MARKER_RE = re.compile(
    r"^[ \t]*Worktree[ \t]+repo:[ \t]*(\S+)[ \t]*$",
    re.IGNORECASE | re.MULTILINE,
)

# Exit code used when WorktreeCreate cannot allocate and pass-through would
# only produce the harness's opaque "returned no worktree path" error.
EXIT_REFUSED = 2


class WorktreeCreateRefused(Exception):
    """Raised when WorktreeCreate must fail loudly instead of passing through.

    ``str(exc)`` is the operator-facing diagnostic written to stderr; the
    harness surfaces hook stderr on a non-zero exit, which is the only channel
    that reaches whoever wrote the prompt.
    """

    def __init__(self, message: str, *, reason: str, extra: dict | None = None):
        super().__init__(message)
        self.reason = reason
        self.extra = extra or {}


def _log(record: dict) -> None:
    """Best-effort JSON-line audit log."""
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        record = {
            "ts": _dt.datetime.now(_dt.timezone.utc).isoformat(),
            "pid": os.getpid(),
            **record,
        }
        with LOG_PATH.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record) + "\n")
        try:
            LOG_PATH.chmod(0o600)
        except OSError:
            pass
    except (OSError, ValueError):
        pass


def _config_files() -> list[Path]:
    """Config paths to read: the ``WORKTREE_ISOLATION_REPOS`` override, else
    the system + user defaults."""
    raw = os.environ.get(CONFIG_ENV_VAR, "").strip()
    if raw:
        return [
            Path(os.path.expanduser(part))
            for part in raw.split(os.pathsep)
            if part.strip()
        ]
    return CONFIG_FILES


def _load_opted_in_repos(
    config_files: list[Path] | None = None,
) -> list[tuple[str, re.Pattern[str], Path]]:
    """Read opted-in repos from the config files.

    Same file format / semantics as pre-agent-worktree-isolation-hook.
    The ``prompt_regex`` field is allowed to contain ``|`` (regex
    alternation), so we peel ``upstream_path`` off the END (rpartition) and
    then split ``repo_key`` off the front of what remains.
    Lines with a missing or malformed upstream_path are skipped (since this
    hook actually needs the path to allocate the worktree).
    """
    if config_files is None:
        config_files = _config_files()
    out: list[tuple[str, re.Pattern[str], Path]] = []
    for path in config_files:
        try:
            if not path.is_file():
                continue
            content = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in content.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            left, sep_up, upstream_str = line.rpartition("|")
            if not sep_up:
                continue
            repo_key, sep_key, regex_src = left.partition("|")
            if not sep_key:
                continue
            repo_key = repo_key.strip()
            regex_src = regex_src.strip()
            upstream_str = upstream_str.strip()
            if not repo_key or not regex_src or not upstream_str:
                continue
            try:
                pat = re.compile(regex_src, re.IGNORECASE)
            except re.error:
                continue
            try:
                upstream = Path(os.path.expanduser(upstream_str))
            except (OSError, ValueError):
                continue
            out.append((repo_key, pat, upstream))
    return out


def _find_opted_in(
    prompt: str,
    opted_in: list[tuple[str, re.Pattern[str], Path]],
) -> tuple[str, Path] | None:
    """Return (repo_key, upstream_path) for the first match, else None."""
    if not prompt:
        return None
    for repo_key, pattern, upstream in opted_in:
        if pattern.search(prompt):
            return (repo_key, upstream)
    return None


def _extract_repo_marker(prompt: str) -> str | None:
    """Return the repo_key named by a ``Worktree repo: <key>`` line, if any."""
    if not prompt:
        return None
    m = REPO_MARKER_RE.search(prompt)
    if m is None:
        return None
    return m.group(1).strip() or None


def _find_opted_in_by_key(
    repo_key: str,
    opted_in: list[tuple[str, re.Pattern[str], Path]],
) -> tuple[str, Path] | None:
    """Exact repo_key lookup. Never a free-form path -- opt-in list only."""
    for key, _pattern, upstream in opted_in:
        if key == repo_key:
            return (key, upstream)
    return None


def _cwd_is_git_repo(cwd: str, runner=subprocess.run) -> bool:
    """True when the harness could allocate the worktree itself from ``cwd``.

    That is the ONLY situation in which empty stdout (pass-through) is a
    useful answer: otherwise the harness turns it into the opaque
    "hook succeeded but returned no worktree path".
    """
    if not cwd or not os.path.isdir(cwd):
        return False
    try:
        proc = runner(
            ["git", "-C", cwd, "rev-parse", "--is-inside-work-tree"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0 and (proc.stdout or "").strip() == "true"


def _payload_cwd(payload: dict) -> str:
    if isinstance(payload, dict):
        for key in ("cwd", "workingDirectory", "working_directory"):
            val = payload.get(key)
            if isinstance(val, str) and val:
                return val
    try:
        return os.getcwd()
    except OSError:
        return ""


def _refusal_message(headline: str, opted_in_keys: list[str], detail: str = "") -> str:
    """Operator-facing stderr diagnostic. Must name the keys AND the fix."""
    keys = ", ".join(opted_in_keys) or "(none configured)"
    example = opted_in_keys[0] if opted_in_keys else "<repo_key>"
    lines = [
        "worktree-create-hook: REFUSED -- cannot allocate an agent worktree.",
        "",
        headline,
    ]
    if detail:
        lines += ["", detail]
    lines += [
        "",
        f"Opted-in repo keys: {keys}",
        "",
        "Fix the Agent spawn in one of two ways:",
        "  1. Name the repo explicitly -- add this line to the Agent prompt",
        "     (the value must be an exact repo_key from the list above):",
        "",
        f"       Worktree repo: {example}",
        "",
        "  2. Or reference the repo's upstream path / slug in the prompt text",
        "     so the opt-in regex matches (e.g. \"~/repos/" + example + "\").",
        "",
        "Config: /etc/claude-code/worktree-isolation-repos.txt",
        "        ~/.config/claude-watch/worktree-isolation-repos.txt",
        "Hook: worktree-create-hook   Audit log: ~/.config/claude/worktree-create.log",
    ]
    return "\n".join(lines)


def _find_opted_in_by_path(
    worktree_path: str,
    opted_in: list[tuple[str, re.Pattern[str], Path]],
) -> tuple[str, Path] | None:
    """Match a worktree path back to its (repo_key, upstream) for removal."""
    if not worktree_path:
        return None
    try:
        norm = os.path.realpath(worktree_path)
    except (OSError, ValueError):
        norm = worktree_path
    for repo_key, _pattern, upstream in opted_in:
        base = WORKTREE_BASE_TMPL.format(repo_key=repo_key)
        if worktree_path.startswith(base + "/") or norm.startswith(base + "/"):
            return (repo_key, upstream)
    return None


def _cache_path_for_session(session_id: str) -> Path:
    """Per-session prompt-cache file path. Same sanitization as the writer."""
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", session_id) or "_"
    safe = safe[:128]
    return CACHE_DIR / CACHE_FILENAME_TMPL.format(session_id=safe)


def _read_prompt_cache(session_id: str | None, ttl: int = CACHE_TTL_SECONDS) -> str:
    if not session_id:
        return ""
    try:
        cache_file = _cache_path_for_session(session_id)
        if not cache_file.is_file():
            return ""
        import time
        age = time.time() - cache_file.stat().st_mtime
        if age > ttl:
            return ""
        return cache_file.read_text(encoding="utf-8")
    except (OSError, ValueError):
        return ""


def _prune_stale_cache(cache_dir: Path = CACHE_DIR, ttl: int = 60) -> None:
    try:
        if not cache_dir.is_dir():
            return
        import time
        now = time.time()
        for f in cache_dir.glob("last-agent-prompt-*.txt"):
            try:
                if now - f.stat().st_mtime > ttl:
                    f.unlink()
            except OSError:
                pass
    except (OSError, ValueError):
        pass


def _extract_prompt_with_source(payload: dict) -> tuple[str, str]:
    """Best-effort extraction of the Agent prompt, plus WHERE it came from.

    Order:
      1. Cache file written by pre-agent-worktree-isolation-hook keyed by
         session_id. TTL: 30s.
      2. Legacy inlined tool_input.prompt / payload.prompt.
      3. Transcript-scan fallback.

    The source label matters for diagnosis. This hook and the Agent-spawn
    isolation gate are supposed to reach the same verdict on the same prompt,
    but only the gate reads the prompt straight out of the tool call it is
    gating. Every other branch here is INDIRECT -- a cache keyed on a
    session_id the payload may not carry, or a scan of the most recently
    modified transcript on the machine. When those two hooks disagree, the
    first thing you need to know is whether they were even looking at the same
    text, and a bare "no opted-in repo in prompt" line cannot tell you that.
    """
    if not isinstance(payload, dict):
        return "", "no-payload"

    session_id = payload.get("session_id")
    if isinstance(session_id, str) and session_id:
        cached = _read_prompt_cache(session_id)
        if cached:
            _prune_stale_cache()
            return cached, "session-cache"

    tool_input = payload.get("tool_input")
    if isinstance(tool_input, dict):
        p = tool_input.get("prompt")
        if isinstance(p, str) and p:
            return p, "tool_input.prompt"
    p = payload.get("prompt")
    if isinstance(p, str) and p:
        return p, "payload.prompt"

    transcript = payload.get("transcript_path")
    if isinstance(transcript, str) and transcript:
        try:
            p = _scan_transcript_for_latest_agent_prompt(Path(transcript))
            if p:
                return p, "transcript_path-scan"
        except (OSError, ValueError):
            pass
    try:
        p = _scan_latest_project_transcript()
        return p, ("latest-transcript-scan" if p else "not-found")
    except (OSError, ValueError):
        return "", "not-found"


def _extract_prompt(payload: dict) -> str:
    """Backwards-compatible wrapper: prompt only."""
    return _extract_prompt_with_source(payload)[0]


def _scan_latest_project_transcript() -> str:
    projects = Path(os.path.expanduser("~/.claude/projects"))
    if not projects.is_dir():
        return ""
    latest: tuple[float, Path] | None = None
    for jsonl in projects.rglob("*.jsonl"):
        try:
            mtime = jsonl.stat().st_mtime
        except OSError:
            continue
        if latest is None or mtime > latest[0]:
            latest = (mtime, jsonl)
    if latest is None:
        return ""
    return _scan_transcript_for_latest_agent_prompt(latest[1])


def _scan_transcript_for_latest_agent_prompt(path: Path) -> str:
    if not path.exists() or not path.is_file():
        return ""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return ""
    for raw in reversed(lines):
        raw = raw.strip()
        if not raw:
            continue
        try:
            entry = json.loads(raw)
        except (json.JSONDecodeError, ValueError):
            continue
        msg = entry.get("message")
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for block in reversed(content):
            if not isinstance(block, dict):
                continue
            if block.get("type") != "tool_use":
                continue
            name = block.get("name")
            if name not in AGENT_TOOL_NAMES:
                continue
            inp = block.get("input")
            if not isinstance(inp, dict):
                continue
            p = inp.get("prompt")
            if isinstance(p, str) and p:
                return p
    return ""


def _extract_worktree_path(payload: dict) -> str:
    if not isinstance(payload, dict):
        return ""
    for key in ("worktree_path", "worktreePath", "path"):
        val = payload.get(key)
        if isinstance(val, str) and val:
            return val
    for nest_key in ("tool_input", "hookSpecificOutput", "hook_input"):
        nest = payload.get(nest_key)
        if isinstance(nest, dict):
            for key in ("worktree_path", "worktreePath", "path"):
                val = nest.get(key)
                if isinstance(val, str) and val:
                    return val
    return ""


def _detect_mode(payload: dict) -> str:
    if isinstance(payload, dict):
        ev = payload.get("hook_event_name") or payload.get("hookEventName")
        if isinstance(ev, str):
            ev_low = ev.strip().lower()
            if "remove" in ev_low:
                return "remove"
            if "create" in ev_low:
                return "create"
    env_mode = os.environ.get("WORKTREE_HOOK_MODE", "").strip().lower()
    if env_mode in ("create", "remove"):
        return env_mode
    if isinstance(payload, dict):
        tn = payload.get("tool_name")
        if isinstance(tn, str) and tn in AGENT_TOOL_NAMES:
            return "create"
    return "unknown"


def handle_create(
    payload: dict,
    *,
    runner=subprocess.run,
    opted_in: list[tuple[str, re.Pattern[str], Path]] | None = None,
) -> str:
    """Decide + (maybe) allocate a worktree. Returns the stdout payload.

    Raises ``WorktreeCreateRefused`` when allocation is impossible AND
    pass-through cannot work (the session cwd is not a git repo), so the
    caller can exit non-zero with a diagnostic instead of handing the harness
    empty stdout.
    """
    if opted_in is None:
        opted_in = _load_opted_in_repos()
    opted_in_keys = [k for k, _p, _u in opted_in]
    prompt, prompt_source = _extract_prompt_with_source(payload)

    def _passthrough_or_refuse(headline: str, detail: str, reason: str, **extra) -> str:
        """Pass through only if the harness can actually take over."""
        record = {
            "event": "create",
            "reason": reason,
            "prompt_source": prompt_source,
            "debug_prompt_len": len(prompt),
            "payload_keys": sorted(k for k in payload if isinstance(k, str)),
            "opted_in_keys": opted_in_keys,
            **extra,
        }
        # Unconfigured host: the hook is documented as a no-op. Never refuse.
        if not opted_in:
            _log({**record, "decision": "passthrough", "passthrough_why": "no opted-in repos configured"})
            return ""
        cwd = _payload_cwd(payload)
        if _cwd_is_git_repo(cwd, runner):
            _log({**record, "decision": "passthrough", "passthrough_why": f"cwd is a git repo: {cwd}"})
            return ""
        _log({**record, "decision": "refused", "cwd": cwd})
        raise WorktreeCreateRefused(
            _refusal_message(headline, opted_in_keys, detail),
            reason=reason,
            extra=record,
        )

    # An explicit `Worktree repo: <repo_key>` line beats the regexes. It is
    # restricted to the opt-in list -- an unknown key is an error, not a
    # silent fallback, or the marker would be a way to typo yourself back
    # into the opaque failure this whole path exists to prevent.
    marker_key = _extract_repo_marker(prompt)
    if marker_key is not None:
        match = _find_opted_in_by_key(marker_key, opted_in)
        if match is None:
            return _passthrough_or_refuse(
                f"The prompt's marker line names repo {marker_key!r}, which is "
                "not in the opt-in list.",
                "Either fix the marker to an exact opted-in repo_key, or add "
                "the repo to the config below (repo_key|prompt_regex|upstream_path).",
                "marker names non-opted-in repo",
                marker_key=marker_key,
            )
    else:
        match = _find_opted_in(prompt, opted_in)

    if match is None:
        # Record WHERE the prompt came from and which keys the payload
        # actually carried. Without this a refusal/passthrough here is
        # indistinguishable from "the prompt genuinely did not name an
        # opted-in repo", and the pair (gate says yes / allocator says no) is
        # undiagnosable after the fact.
        return _passthrough_or_refuse(
            "The Agent spawn requested worktree isolation, but the prompt names "
            "no opted-in repo -- so there is no upstream repository to branch from.",
            f"(prompt source: {prompt_source}, {len(prompt)} chars)",
            "no opted-in repo in prompt",
        )

    repo_key, upstream = match
    if not upstream.exists():
        return _passthrough_or_refuse(
            f"Opted-in repo {repo_key!r} matched, but its configured "
            f"upstream path does not exist: {upstream}",
            "Fix the upstream_path field for this repo in the config below.",
            "upstream path does not exist",
            repo_key=repo_key,
            upstream=str(upstream),
        )

    base = Path(WORKTREE_BASE_TMPL.format(repo_key=repo_key))
    try:
        base.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        return _passthrough_or_refuse(
            f"Opted-in repo {repo_key!r} matched, but the worktree base "
            f"directory could not be created: {base}",
            f"mkdir failed: {exc}",
            "mkdir failed",
            repo_key=repo_key,
        )

    wt_id = uuid.uuid4().hex[:12]
    wt_path = base / f"agent-{wt_id}"
    branch = f"worktree-{wt_id}"

    # Resolve base ref: prefer origin/main; fall back to main, then HEAD.
    base_ref = "origin/main"
    try:
        probe = runner(
            ["git", "-C", str(upstream), "rev-parse", "--verify", "--quiet", base_ref],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if probe.returncode != 0:
            base_ref = "main"
            probe = runner(
                ["git", "-C", str(upstream), "rev-parse", "--verify", "--quiet", base_ref],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
            if probe.returncode != 0:
                base_ref = "HEAD"
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _passthrough_or_refuse(
            f"Opted-in repo {repo_key!r} matched, but resolving a base ref in "
            f"{upstream} failed.",
            f"git rev-parse failed: {exc}",
            "rev-parse failed",
            repo_key=repo_key,
        )

    cmd = [
        "git", "-C", str(upstream), "worktree", "add",
        "-b", branch, str(wt_path), base_ref,
    ]
    try:
        proc = runner(cmd, capture_output=True, text=True, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return _passthrough_or_refuse(
            f"Opted-in repo {repo_key!r} matched, but `git worktree add` could "
            "not be run.",
            f"git worktree add raised: {exc}",
            "worktree add raised",
            repo_key=repo_key,
        )

    if proc.returncode != 0:
        return _passthrough_or_refuse(
            f"Opted-in repo {repo_key!r} matched, but `git worktree add` failed "
            f"in {upstream}.",
            "git stderr: " + (proc.stderr or "").strip()[:500],
            "git worktree add returned non-zero",
            repo_key=repo_key,
            stderr=(proc.stderr or "")[:500],
            stdout=(proc.stdout or "")[:500],
        )

    _log({
        "event": "create",
        "decision": "allocated",
        "repo_key": repo_key,
        "upstream": str(upstream),
        "worktree_path": str(wt_path),
        "branch": branch,
        "base_ref": base_ref,
    })
    return str(wt_path)


def handle_remove(
    payload: dict,
    *,
    runner=subprocess.run,
    opted_in: list[tuple[str, re.Pattern[str], Path]] | None = None,
) -> None:
    """Tear down a worktree we previously created. No stdout output expected."""
    if opted_in is None:
        opted_in = _load_opted_in_repos()
    wt_path = _extract_worktree_path(payload)
    match = _find_opted_in_by_path(wt_path, opted_in)
    if match is None:
        _log({"event": "remove", "decision": "ignored", "reason": "not our worktree", "path": wt_path})
        return

    repo_key, upstream = match
    cmd = ["git", "-C", str(upstream), "worktree", "remove", "--force", wt_path]
    try:
        proc = runner(cmd, capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        _log({"event": "remove", "decision": "best-effort-failed", "reason": str(exc), "path": wt_path})
        proc = None

    try:
        if os.path.isdir(wt_path):
            shutil.rmtree(wt_path, ignore_errors=True)
    except OSError:
        pass

    _log({
        "event": "remove",
        "decision": "cleaned" if proc and proc.returncode == 0 else "best-effort",
        "repo_key": repo_key,
        "path": wt_path,
        "git_rc": (proc.returncode if proc else None),
        "git_stderr": ((proc.stderr or "")[:500] if proc else None),
    })


def main() -> int:
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except (json.JSONDecodeError, ValueError):
        _log({"event": "parse_error", "raw_preview": raw[:200]})
        return 0

    mode = _detect_mode(payload)
    try:
        if mode == "remove":
            handle_remove(payload)
            return 0
        if mode == "create":
            try:
                out = handle_create(payload)
            except WorktreeCreateRefused as refusal:
                # Fail LOUDLY. Empty stdout here becomes the harness's opaque
                # "hook succeeded but returned no worktree path", which names
                # neither the cause nor the fix; stderr + non-zero does both.
                try:
                    sys.stderr.write(str(refusal) + "\n")
                except OSError:
                    pass
                return EXIT_REFUSED
            if out:
                sys.stdout.write(out + "\n")
            return 0
        _log({"event": "unknown_mode", "payload_keys": list(payload.keys()) if isinstance(payload, dict) else None})
        return 0
    except Exception as exc:  # noqa: BLE001 -- default-open
        _log({"event": "uncaught", "error": str(exc), "mode": mode})
        try:
            sys.stderr.write(f"worktree-create-hook: uncaught error: {exc}\n")
        except OSError:
            pass
        return 0


# ---------------------------------------------------------------------------
# Embedded test suite
# ---------------------------------------------------------------------------

# Canonical opted-in fixture for tests (independent of config files on disk).
_TEST_CW_PATTERN = re.compile(
    r"(?:"
    r"~/repos/claude-watch\b"
    r"|/home/[^/\s]+/repos/claude-watch\b"
    r"|\brepos/claude-watch\b"
    r"|\b(?:hndrewaall|gbre-org)/claude-watch\b"
    r"|\bgithub\.com/(?:hndrewaall|gbre-org)/claude-watch\b"
    r")",
    re.IGNORECASE,
)


def _run_tests() -> int:  # noqa: C901
    import tempfile

    results: list[bool] = []

    def _check(name: str, cond: bool, detail: str = "") -> None:
        if cond:
            print(f"  PASS  {name}")
            results.append(True)
        else:
            print(f"  FAIL  {name}  {detail}")
            results.append(False)

    print("=== Unit tests ===")

    fixture = [("claude-watch", _TEST_CW_PATTERN, Path("/nonexistent/cw"))]

    m = _find_opted_in("Work in ~/repos/claude-watch and rebase.", fixture)
    _check("1. _find_opted_in cw prompt matches", m is not None and m[0] == "claude-watch", f"m={m}")

    m = _find_opted_in("Just look at ~/repos/media-tools, no cw.", fixture)
    _check("2. _find_opted_in non-cw passthrough", m is None, f"m={m}")

    m = _find_opted_in("Open PR github.com/gbre-org/claude-watch/pulls/123", fixture)
    _check("3. github.com URL matches", m is not None and m[0] == "claude-watch", f"m={m}")

    # The repo moved orgs; the default regex keeps matching the FORMER owner so
    # older prompts / pasted links still opt in to worktree isolation.
    m = _find_opted_in("Open PR github.com/hndrewaall/claude-watch/pulls/123", fixture)
    _check("3b. former-owner github.com URL still matches",
           m is not None and m[0] == "claude-watch", f"m={m}")

    p = _extract_prompt({"tool_name": "Agent", "tool_input": {"prompt": "hello"}})
    _check("4. prompt extracted from tool_input", p == "hello", f"p={p!r}")

    mode = _detect_mode({"hook_event_name": "WorktreeCreate"})
    _check("5. detect_mode WorktreeCreate", mode == "create", f"mode={mode}")
    mode = _detect_mode({"hook_event_name": "WorktreeRemove"})
    _check("6. detect_mode WorktreeRemove", mode == "remove", f"mode={mode}")

    wt = _extract_worktree_path({"worktree_path": "/tmp/cw-worktrees/agent-x"})
    _check("7. extract worktree_path top-level", wt == "/tmp/cw-worktrees/agent-x", f"wt={wt}")
    wt = _extract_worktree_path({"tool_input": {"worktreePath": "/tmp/cw-worktrees/agent-y"}})
    _check("8. extract worktreePath nested", wt == "/tmp/cw-worktrees/agent-y", f"wt={wt}")

    m = _find_opted_in_by_path("/tmp/claude-watch-worktrees/agent-deadbeef", fixture)
    _check("9. find_by_path matches our cw base", m is not None and m[0] == "claude-watch", f"m={m}")

    m = _find_opted_in_by_path("/home/u/repos/foo/bar", fixture)
    _check("10. find_by_path rejects foreign", m is None, f"m={m}")

    print("=== No-match failure posture ===")

    # THE BUG: a spawn that asked for isolation but whose prompt matches no
    # opted-in repo used to exit 0 with empty stdout, which the harness
    # reports as "hook succeeded but returned no worktree path" -- naming
    # neither the cause nor the fix. It must fail loudly instead.
    two_key_fixture = [
        ("claude-watch", _TEST_CW_PATTERN, Path("/nonexistent/cw")),
        ("media-tools", re.compile(r"\brepos/media-tools\b", re.IGNORECASE), Path("/nonexistent/mt")),
    ]
    nongit_cwd = {"tool_name": "Agent", "cwd": "/nonexistent-not-a-git-repo"}

    try:
        out = handle_create(
            {**nongit_cwd, "tool_input": {"prompt": "Do some work somewhere."}},
            opted_in=two_key_fixture,
        )
        _check("11. no-match + non-git cwd refuses loudly", False, f"returned {out!r}")
    except WorktreeCreateRefused as exc:
        msg = str(exc)
        _check("11. no-match + non-git cwd refuses loudly", True)
        _check(
            "11a. refusal names every opted-in repo key",
            "claude-watch" in msg and "media-tools" in msg,
            f"msg={msg!r}",
        )
        _check(
            "11b. refusal tells the caller how to fix the prompt",
            "Worktree repo:" in msg and "regex" in msg,
            f"msg={msg!r}",
        )

    # Unconfigured host: the hook is documented as a no-op. Never refuse.
    out = handle_create(
        {**nongit_cwd, "tool_input": {"prompt": "Do some work somewhere."}},
        opted_in=[],
    )
    _check("11c. no opted-in repos configured -> silent passthrough", out == "", f"out={out!r}")

    print("=== Config-file loader tests ===")

    with tempfile.TemporaryDirectory() as tmpdir:
        td = Path(tmpdir)
        cfg = td / "repos.txt"
        cfg.write_text(
            "# comment\n"
            "\n"
            "claude-watch|\\bclaude-watch\\b|/home/u/repos/claude-watch\n"
        )
        loaded = _load_opted_in_repos([cfg])
        _check("CFG1. one entry parsed", len(loaded) == 1 and loaded[0][0] == "claude-watch", f"loaded={loaded}")

    with tempfile.TemporaryDirectory() as tmpdir:
        td = Path(tmpdir)
        cfg = td / "repos.txt"
        cfg.write_text(
            "no-upstream|\\bfoo\\b\n"  # only 2 fields -> skipped
            "claude-watch|\\bcw\\b|/home/u/repos/claude-watch\n"
            "bad|[unclosed-regex|/y\n"
            "  | no-key | path\n"
        )
        loaded = _load_opted_in_repos([cfg])
        _check(
            "CFG2. malformed lines skipped, valid line kept",
            len(loaded) == 1 and loaded[0][0] == "claude-watch",
            f"loaded={loaded}",
        )

    with tempfile.TemporaryDirectory() as tmpdir:
        td = Path(tmpdir)
        loaded = _load_opted_in_repos([td / "doesnt-exist.txt"])
        _check("CFG3. missing config file -> empty list", loaded == [], f"loaded={loaded}")

    # Regex containing `|` (alternation) -- the parser must NOT swallow
    # alternations into the upstream_path field.
    with tempfile.TemporaryDirectory() as tmpdir:
        td = Path(tmpdir)
        cfg = td / "repos.txt"
        cfg.write_text(
            "claude-watch|(?:~/repos/claude-watch\\b|/home/[^/\\s]+/repos/claude-watch\\b)|/home/u/repos/claude-watch\n"
        )
        loaded = _load_opted_in_repos([cfg])
        _check(
            "CFG4. regex with `|` alternation parsed (no field-split bug)",
            len(loaded) == 1
            and loaded[0][0] == "claude-watch"
            and str(loaded[0][2]) == "/home/u/repos/claude-watch"
            and loaded[0][1].search("/home/foo/repos/claude-watch") is not None
            and loaded[0][1].search("~/repos/claude-watch") is not None,
            f"loaded={loaded}",
        )

    print("=== Integration tests (real git repo) ===")

    with tempfile.TemporaryDirectory() as tmp:
        tmp_repo = Path(tmp) / "fake-cw"
        tmp_repo.mkdir()
        subprocess.run(["git", "init", "-q", "-b", "main", str(tmp_repo)], check=True)
        subprocess.run(
            ["git", "-C", str(tmp_repo), "config", "user.email", "test@example.com"],
            check=True,
        )
        subprocess.run(
            ["git", "-C", str(tmp_repo), "config", "user.name", "test"],
            check=True,
        )
        (tmp_repo / "README.md").write_text("hi\n")
        subprocess.run(["git", "-C", str(tmp_repo), "add", "README.md"], check=True)
        subprocess.run(
            ["git", "-C", str(tmp_repo), "commit", "-q", "-m", "init"], check=True
        )
        subprocess.run(
            ["git", "-C", str(tmp_repo), "update-ref", "refs/remotes/origin/main", "main"],
            check=True,
        )

        test_opted_in = [
            ("claude-watch-test", re.compile(r"FAKE_CW_MARKER", re.IGNORECASE), tmp_repo)
        ]

        try:
            out = handle_create(
                {"tool_name": "Agent", "tool_input": {"prompt": "Reference: FAKE_CW_MARKER for this test."}},
                opted_in=test_opted_in,
            )
            ok = bool(out) and Path(out).exists() and Path(out).is_dir()
            _check("12. handle_create allocates a real worktree", ok, f"out={out!r}")

            if ok:
                lst = subprocess.run(
                    ["git", "-C", str(tmp_repo), "worktree", "list", "--porcelain"],
                    capture_output=True, text=True, check=False,
                )
                listed = out in lst.stdout
                _check("13. git worktree list registers it", listed, f"stdout={lst.stdout!r}")
            else:
                _check("13. git worktree list registers it", False, "skipped")

            if ok:
                handle_remove(
                    {"hook_event_name": "WorktreeRemove", "worktree_path": out},
                    opted_in=test_opted_in,
                )
                still = Path(out).exists()
                lst = subprocess.run(
                    ["git", "-C", str(tmp_repo), "worktree", "list", "--porcelain"],
                    capture_output=True, text=True, check=False,
                )
                listed = out in lst.stdout
                _check("14. handle_remove drops the dir", not still, f"still_exists={still}")
                _check("15. handle_remove drops from git worktree list", not listed, f"stdout={lst.stdout!r}")
            else:
                _check("14. handle_remove drops the dir", False, "skipped")
                _check("15. handle_remove drops from git worktree list", False, "skipped")

            try:
                handle_remove(
                    {"hook_event_name": "WorktreeRemove", "worktree_path": "/tmp/not-ours/foo"},
                    opted_in=test_opted_in,
                )
                _check("16. handle_remove ignores foreign path", True)
            except Exception as exc:  # noqa: BLE001
                _check("16. handle_remove ignores foreign path", False, f"raised: {exc}")

            # Pass-through is still correct when the harness can allocate the
            # worktree itself, i.e. the session cwd IS inside a git repo.
            try:
                out = handle_create(
                    {
                        "tool_name": "Agent",
                        "cwd": str(tmp_repo),
                        "tool_input": {"prompt": "No opted-in repo named here."},
                    },
                    opted_in=test_opted_in,
                )
                _check("16a. no-match but cwd IS a git repo -> passthrough", out == "", f"out={out!r}")
            except WorktreeCreateRefused as exc:
                _check("16a. no-match but cwd IS a git repo -> passthrough", False, f"refused: {exc}")

            # The marker selects the repo even though nothing in the prompt
            # matches the opt-in regex -- the exact case a prompt rewrite that
            # drops the repo path used to break.
            marker_out = ""
            try:
                marker_out = handle_create(
                    {
                        "tool_name": "Agent",
                        "cwd": "/nonexistent-not-a-git-repo",
                        "tool_input": {
                            "prompt": "Fix a bug, no path mentioned.\nWorktree repo: claude-watch-test\n",
                        },
                    },
                    opted_in=test_opted_in,
                )
                ok = bool(marker_out) and Path(marker_out).is_dir()
                _check("16b. marker selects the opted-in repo", ok, f"out={marker_out!r}")
            except WorktreeCreateRefused as exc:
                _check("16b. marker selects the opted-in repo", False, f"refused: {exc}")
            finally:
                if marker_out:
                    handle_remove(
                        {"hook_event_name": "WorktreeRemove", "worktree_path": marker_out},
                        opted_in=test_opted_in,
                    )

            # A marker naming a key that is not opted in is an error, not a
            # silent fallback -- and never a free-form path.
            for bad, label in (
                ("some-other-repo", "16c. marker naming a non-opted-in key refuses"),
                ("/home/u/repos/claude-watch", "16d. marker naming a free-form path refuses"),
            ):
                try:
                    out = handle_create(
                        {
                            "tool_name": "Agent",
                            "cwd": "/nonexistent-not-a-git-repo",
                            "tool_input": {"prompt": f"Do work.\nWorktree repo: {bad}\n"},
                        },
                        opted_in=test_opted_in,
                    )
                    _check(label, False, f"returned {out!r}")
                except WorktreeCreateRefused as exc:
                    msg = str(exc)
                    _check(label, bad in msg and "claude-watch-test" in msg, f"msg={msg!r}")

        finally:
            try:
                leftover = Path(WORKTREE_BASE_TMPL.format(repo_key="claude-watch-test"))
                if leftover.exists():
                    shutil.rmtree(leftover, ignore_errors=True)
            except OSError:
                pass

    print("=== Subprocess smoke tests ===")
    script = Path(__file__).resolve()

    # Hermetic config: never depend on what happens to be installed on the
    # host running the tests (CI has no config file at all).
    with tempfile.TemporaryDirectory() as tmpdir:
        cfg = Path(tmpdir) / "repos.txt"
        cfg.write_text(
            "claude-watch|\\brepos/claude-watch\\b|/nonexistent/cw\n"
            "media-tools|\\brepos/media-tools\\b|/nonexistent/mt\n"
        )
        env = {**os.environ, "WORKTREE_ISOLATION_REPOS": str(cfg)}

        proc = subprocess.run(
            [str(script)],
            input=json.dumps({
                "hook_event_name": "WorktreeCreate",
                "tool_name": "Agent",
                "cwd": "/nonexistent-not-a-git-repo",
                "tool_input": {"prompt": "Work on something unnamed."},
            }),
            capture_output=True, text=True, timeout=10, check=False, env=env,
        )
        _check(
            "17. subprocess no-match create -> non-zero exit, empty stdout",
            proc.returncode != 0 and proc.stdout.strip() == "",
            f"rc={proc.returncode} stdout={proc.stdout!r}",
        )
        _check(
            "17a. subprocess refusal stderr names the keys + the fix",
            "claude-watch" in proc.stderr
            and "media-tools" in proc.stderr
            and "Worktree repo:" in proc.stderr,
            f"stderr={proc.stderr!r}",
        )

        # Config override with no readable entries -> unconfigured -> no-op.
        proc = subprocess.run(
            [str(script)],
            input=json.dumps({
                "hook_event_name": "WorktreeCreate",
                "tool_name": "Agent",
                "cwd": "/nonexistent-not-a-git-repo",
                "tool_input": {"prompt": "Work on something unnamed."},
            }),
            capture_output=True, text=True, timeout=10, check=False,
            env={**os.environ, "WORKTREE_ISOLATION_REPOS": str(Path(tmpdir) / "absent.txt")},
        )
        _check(
            "17b. subprocess unconfigured host -> exit 0 passthrough",
            proc.returncode == 0 and proc.stdout.strip() == "",
            f"rc={proc.returncode} stdout={proc.stdout!r} stderr={proc.stderr!r}",
        )

    proc = subprocess.run(
        [str(script)],
        input="not json {{{",
        capture_output=True, text=True, timeout=5, check=False,
    )
    _check(
        "18. subprocess malformed stdin -> default-open exit 0",
        proc.returncode == 0 and proc.stdout.strip() == "",
        f"rc={proc.returncode} stdout={proc.stdout!r}",
    )

    proc = subprocess.run(
        [str(script)],
        input=json.dumps({
            "hook_event_name": "WorktreeRemove",
            "worktree_path": "/tmp/some-random-dir/agent-x",
        }),
        capture_output=True, text=True, timeout=5, check=False,
    )
    _check(
        "19. subprocess WorktreeRemove foreign -> exit 0 no stdout",
        proc.returncode == 0 and proc.stdout.strip() == "",
        f"rc={proc.returncode} stdout={proc.stdout!r}",
    )

    proc = subprocess.run(
        [str(script)],
        input="",
        capture_output=True, text=True, timeout=5, check=False,
    )
    _check(
        "20. subprocess empty stdin -> default-open",
        proc.returncode == 0 and proc.stdout.strip() == "",
        f"rc={proc.returncode} stdout={proc.stdout!r}",
    )

    total = len(results)
    passed = sum(1 for r in results if r)
    print()
    print(f"RESULT: {passed}/{total} passed")
    return 0 if passed == total else 1


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--test":
        sys.exit(_run_tests())
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 -- last-ditch default-open
        try:
            sys.stderr.write(f"worktree-create-hook: unexpected error: {exc}\n")
        except OSError:
            pass
        sys.exit(0)
